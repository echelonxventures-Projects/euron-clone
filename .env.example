# Local SQLite file by default. For production use Turso: libsql://<db>.turso.io
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Razorpay — https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Leave empty in development to use the mock checkout (disabled in production).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks → secret you set for events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=""
